DEBUG = 0
STATIC_RUNTIME = 0
STATIC_CUDA = 0

CC = cl

ifeq ($(STATIC_RUNTIME), 1)
  ifeq ($(DEBUG), 1)
    RUNTIME_FLAG = /MTd
  else
    RUNTIME_FLAG = /MT
  endif
else
  ifeq ($(DEBUG), 1)
    RUNTIME_FLAG = /MDd
  else
    RUNTIME_FLAG = /MD
  endif
endif

CFLAGS = /W4 /I"$(CUDA_PATH)\include" /I"$(CUDA_PATH)\include\cudart" /nologo $(RUNTIME_FLAG)

ifeq ($(DEBUG), 1)
  CFLAGS += /Od /Zi /RTC1
else
  CFLAGS += /O2 /GL /Gw /fp:fast
endif

NVCCFLAGS = -m64 --ptxas-options=-v -Wno-deprecated-gpu-targets
CUFLAGS = -DWIN64 $(NVCCFLAGS) -Xcompiler "$(RUNTIME_FLAG)"

ifeq ($(DEBUG), 1)
  NVCCFLAGS += -g -G -O1
  CUFLAGS += -Xcompiler "/EHsc /W4 /nologo /Od /Zi"
else
  NVCCFLAGS += -O3 
  CUFLAGS += -Xcompiler "/EHsc /W4 /nologo /O2 /Gw"
endif

############################################################

# generate code for compute capabilities - see this table for supported
# versions: https://en.wikipedia.org/wiki/CUDA#GPUs_supported
#
# As in Makefile, a cubin is built for each compute capability in
# CUDA_ARCHS_WANTED that this nvcc supports (nvcc --list-gpu-code), plus PTX
# for the oldest one. CUDA_LEGACY_ARCHS=1 adds Maxwell, Pascal and Volta (CUDA
# 12.x and older only); `make CUDA_ARCHS="86 89"` skips detection.
CUDA_ARCHS_WANTED = 75 80 86 87 88 89 90 100 103 110 120 121
CUDA_LEGACY_ARCHS = 0
ifeq ($(CUDA_LEGACY_ARCHS), 1)
  CUDA_ARCHS_WANTED := 50 52 53 60 61 62 70 72 $(CUDA_ARCHS_WANTED)
endif
ifeq ($(origin CUDA_ARCHS), undefined)
  NVCC_GPU_CODES := $(patsubst sm_%,%,$(filter sm_%,$(shell nvcc --list-gpu-code)))
  CUDA_ARCHS := $(filter $(NVCC_GPU_CODES),$(CUDA_ARCHS_WANTED))
  ifeq ($(CUDA_ARCHS),)
    CUDA_ARCHS := 75 80 86 89 90
  endif
endif
NVCCFLAGS += $(foreach cc,$(CUDA_ARCHS),--generate-code arch=compute_$(cc),code=sm_$(cc))
CUDA_PTX_ARCH = $(firstword $(CUDA_ARCHS))
ifneq ($(CUDA_PTX_ARCH),)
  NVCCFLAGS += --generate-code arch=compute_$(CUDA_PTX_ARCH),code=compute_$(CUDA_PTX_ARCH)
endif

############################################################

LINK = link

ifeq ($(DEBUG), 1)
  LFLAGS = /nologo
else
  LFLAGS = /nologo /LTCG /OPT:REF /OPT:ICF
endif

CSRC  = sieve.c timer.c parse.c read_config.c mfaktc.c checkpoint.c \
	filelocking.c signal_handler.c output.c crc.c
CUSRC = tf_96bit.cu tf_barrett96.cu tf_barrett96_gs.cu gpusieve.cu \
        cuda_utils.cu

CUOBJS = $(CUSRC:.cu=.obj) tf_75bit.obj
COBJS  = $(CSRC:.c=.obj)

RC    = mfaktc.rc
RES   = $(RC:.rc=.res)
ICON  = mfaktc.ico

ifeq ($(STATIC_CUDA), 1)
  LIBS = "$(CUDA_PATH)\lib\x64\cudart_static.lib"
else
  LIBS = "$(CUDA_PATH)\lib\x64\cudart.lib"
endif

INSTALL = copy

############################################################################################################

all : ..\mfaktc-win-64.exe ..\mfaktc.ini.example

..\mfaktc-win-64.exe : $(COBJS) $(CUOBJS) $(RES)
	$(LINK) $(LFLAGS) $^ $(LIBS) /out:$@

clean :
	del *.obj $(RC) $(RES) $(ICON)

############################################################################################################

%.obj : %.c
	$(CC) $(CFLAGS) /c /Tp $<

%.rc : assets\\%.rc
	$(INSTALL) $< .

%.res : %.rc $(ICON)
	rc /fo $@ $<

tf_75bit.obj : tf_96bit.cu
	nvcc -c $< -o $@ $(CUFLAGS) -DSHORTCUT_75BIT

%.obj : %.cu
	nvcc -c $< -o $@ $(CUFLAGS)

# install the default settings as mfaktc.ini.example so that an existing
# mfaktc.ini isn't overwritten; mfaktc creates mfaktc.ini from it on first
# start unless a custom INI file is specified
..\mfaktc.ini.example : mfaktc.ini
	$(INSTALL) $< $@

assets\\icons\\mfaktc.ico : assets\\icons\\mfaktc_16x16.png assets\\icons\\mfaktc_24x24.png assets\\icons\\mfaktc_32x32.png assets\\icons\\mfaktc_48x48.png assets\\icons\\mfaktc_256x256.png
	magick convert $^ $@

$(ICON) : assets\\icons\\mfaktc.ico
	$(INSTALL) $< .

.PHONY: all clean
